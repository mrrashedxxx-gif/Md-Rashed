<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dark_gradient"
    android:fitsSystemWindows="true">

    <!-- শীর্ষ হেডার অংশ -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvAppSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_subtitle"
                android:textColor="@color/arc_reactor_cyan"
                android:textSize="12sp"
                android:letterSpacing="0.02" />
        </LinearLayout>

        <!-- ব্যবহারকারী সম্বোধন "বস" ব্যাজ -->
        <TextView
            android:id="@+id/tvUserBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="@string/user_address"
            android:textColor="@color/arc_reactor_pink"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- সেন্ট্রাল আর্ক রিঅ্যাক্টর ও ১১০ডিপি মাইক বাটন সেকশন -->
    <FrameLayout
        android:id="@+id/arcReactorContainer"
        android:layout_width="220dp"
        android:layout_height="220dp"
        app:layout_constraintBottom_toTopOf="@+id/tvStatus"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerLayout"
        app:layout_constraintVertical_bias="0.35">

        <!-- বহিঃস্থ পালসিং গ্লো রিং -->
        <View
            android:id="@+id/outerPulseRing"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_arc_glow_ring" />

        <!-- মধ্যবর্তী সায়ান রিং -->
        <View
            android:id="@+id/middleRing"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_arc_glow_ring" />

        <!-- মূল ১১০ ডিপি সার্কুলার মাইক বাটন (Arc Reactor Pink #FF00A6) -->
        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_arc_reactor"
            android:contentDescription="@string/tap_to_speak"
            android:elevation="8dp"
            android:padding="24dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mic_pink" />
    </FrameLayout>

    <!-- স্ট্যাটাস টেক্সট (অপেক্ষায় / শুনছি / বলছি) -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/status_idle"
        android:textColor="@color/status_idle_color"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.04"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/arcReactorContainer" />

    <TextView
        android:id="@+id/tvInstructionHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/tap_to_speak"
        android:textColor="@color/text_dim"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvStatus" />

    <!-- কথোপকথন ও নির্দেশনা কার্ড -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardConversation"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="16dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toTopOf="@+id/scrollChips"
        app:layout_constraintTop_toBottomOf="@+id/tvInstructionHint">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ব্যবহারকারীর কথা -->
                <TextView
                    android:id="@+id/tvUserQueryLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/user_query_label"
                    android:textColor="@color/arc_reactor_pink"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUserQuery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="—"
                    android:textColor="@color/text_white"
                    android:textSize="15sp"
                    android:lineSpacingExtra="3dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/card_border" />

                <!-- জারভিসের উত্তর -->
                <TextView
                    android:id="@+id/tvJarvisReplyLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/jarvis_response_label"
                    android:textColor="@color/arc_reactor_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvJarvisReply"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/greeting_boss"
                    android:textColor="@color/text_white"
                    android:textSize="15sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

    <!-- দ্রুত ভয়েস কমান্ড সাজেশনের চিপ লিস্ট -->
    <HorizontalScrollView
        android:id="@+id/scrollChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingBottom="12dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/bottomControlBar">

        <LinearLayout
            android:id="@+id/chipsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipYoutube"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="ইউটিউব"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipWhatsapp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="হোয়াটসঅ্যাপ"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipCallMom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="মাকে ফোন দাও"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="সময় কত"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="আজকের তারিখ"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipMusic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="গান বাজাও"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipTorch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="ফ্ল্যাশলাইট অন"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipFacebook"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="ফেসবুক"
                android:textColor="@color/text_white"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- বটম কন্ট্রোল ও পারমিশন নোটিফিকেশন বার -->
    <LinearLayout
        android:id="@+id/bottomControlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnPermissionRequest"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:backgroundTint="@color/arc_reactor_pink"
            android:text="@string/btn_grant_permissions"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnStopVoice"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:backgroundTint="@color/chip_bg"
            android:text="কথা থামাও"
            android:textColor="@color/arc_reactor_cyan"
            android:textSize="12sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
